<?xml version="1.0" encoding="utf-8"?>
<Assets>
  <!-- Single-part Project Hail Mary ship.
       KSA part-space frame: +X = nose/flight direction (habitat pod at +X ~85),
       -X = aft/engine, Y = lateral solar-panel booms (+/-65), Z = up (+/-16).
       COM ~ (15,0,0). Force on ship = -ExhaustDirection.
       Controls: pitch = torque about Y (pitch up = -Y), yaw = torque about Z
       (yaw right = +Z), roll = torque about X (roll right = -X).
       RCS: 4 thrusters at the nose pod + 4 at the hull aft give pure pitch/yaw
       couples; 8 thrusters on the solar-panel tips give a pure roll couple;
       6 dedicated thrusters near COM give clean +/-X/Y/Z translation. -->
  <PartGameData Id="KSARS_PHM_Ship" DisplayName="Hail Mary">
    <EditorTag Value="Interstellar" />
    <EditorTag Value="NoFaceSnapping" />
    <Diameter M="32" />

    <Control />
    <Battery>
      <MaximumCapacity J="20000" />
    </Battery>

    <!-- ~105t dry + ~9t tanks/fuel -> ~114t wet; the ~57MN fusion torch yields TWR ~50.
         Retune Mass Kg if in-game thrust differs. -->
    <CustomMass>
      <LocationAsmb X="15" Y="0" Z="0" />
      <Mass Kg="105000" />
      <MassSpecificInertia Ixx="400" Iyy="1500" Izz="1500" />
    </CustomMass>

    <Collider Id="Collider1">
      <!-- main spine + habitat structure (long axis X) -->
      <Box Id="HullBox">
        <LocationAsmb X="25" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="112" />
        <LengthY M="22" />
        <LengthZ M="22" />
      </Box>
      <!-- aft solar panel array -->
      <Box Id="PanelsBox">
        <LocationAsmb X="-17" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="19" />
        <LengthY M="130" />
        <LengthZ M="5" />
      </Box>
      <!-- habitat pod forward (cylinder axis X) -->
      <Cylinder Id="PodCollider">
        <LocationAsmb X="68" Y="1" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="1.5708" />
        <LengthY M="32" />
        <Radius M="13" />
      </Cylinder>
    </Collider>

    <!-- Fusion drive propellant (H2) -->
    <Tank Id="MainTank">
      <CylindricalTank>
        <Material Id="Aluminum.2014(s)" />
        <RoleAffinity>Engine</RoleAffinity>
        <LocationAsmb X="10" Y="0" Z="0" />
        <Paf2Asmb X="0" Y="0" Z="1.5708" />
        <Length M="6" />
        <OuterRadius M="1.5" />
        <WallThickness Mm="4" />
      </CylindricalTank>
    </Tank>
    <!-- RCS propellant (MMH/NTO) -->
    <Tank Id="RcsTank">
      <CylindricalTank>
        <Material Id="Aluminum.2014(s)" />
        <RoleAffinity>Thruster</RoleAffinity>
        <LocationAsmb X="20" Y="0" Z="0" />
        <Paf2Asmb X="0" Y="0" Z="1.5708" />
        <Length M="10" />
        <OuterRadius M="1.5" />
        <WallThickness Mm="4" />
      </CylindricalTank>
    </Tank>

    <!-- Main engine: the native FPD-1 fusion torch subpart instanced at the hull aft
         (KSARS_PHM_EngineNozzle in the Assets file). Its SubPartGameData carries the
         full Rocket+ThermalCore+DeLavalNozzle, so the gimbal binds natively. -->
    <RocketEngineController Id="MainEngine">
      <RocketReference Id="Engine" SubPartId="KSARS_PHM_EngineNozzle" />
    </RocketEngineController>
    <ConsumerFeedWiring Id="FusionCore" SubPartId="KSARS_PHM_EngineNozzle">
      <FeedsFrom Container="MainTank" />
    </ConsumerFeedWiring>
    <SubPart Id="KSARS_PHM_EngineNozzle">
      <Gimbal>
        <MaxAngleY Degrees="2" />
        <MaxAngleZ Degrees="2" />
        <ConstrainToCircle Value="false" />
      </Gimbal>
    </SubPart>

