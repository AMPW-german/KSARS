<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\KSARS\KSARS.csproj" AdditionalProperties="SkipModPackaging=true" />
	</ItemGroup>

	<Target Name="RequireKsaDirForBaseline" BeforeTargets="Build" Condition="'$(VerifyRendererBaseline)' == 'true' and '$(KSADir)' == ''">
		<Error Text="VerifyRendererBaseline=true requires -p:KSADir=&quot;path&quot; pointing at a Kitten Space Agency install directory containing KSA.dll." />
	</Target>

	<ItemGroup Condition="'$(VerifyRendererBaseline)' == 'true'">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>VerifyRendererBaseline</_Parameter1>
			<_Parameter2>true</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>KSADir</_Parameter1>
			<_Parameter2>$(KSADir)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>KSAModsDir</_Parameter1>
			<_Parameter2>$(KSAModsDir)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<Import Project="RuntimeStage.targets" />

</Project>
