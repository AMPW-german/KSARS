<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\local.config.props" Condition="Exists('$(MSBuildThisFileDirectory)..\local.config.props')" />

  <PropertyGroup>
    <KSADir Condition="'$(KSADir)' == '' and '$(KSA_DIR)' != ''">$(KSA_DIR)</KSADir>
    <KSADir Condition="'$(KSADir)' == ''">C:/Program Files/Kitten Space Agency/</KSADir>
    <KSADir Condition="!HasTrailingSlash('$(KSADir)')">$(KSADir)/</KSADir>

    <KSAModsDir Condition="'$(KSAModsDir)' == '' and '$(KSA_MODS_DIR)' != ''">$(KSA_MODS_DIR)</KSAModsDir>
    <KSAModsDir Condition="'$(KSAModsDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))/My Games/Kitten Space Agency/mods/</KSAModsDir>
    <KSAModsDir Condition="!HasTrailingSlash('$(KSAModsDir)')">$(KSAModsDir)/</KSAModsDir>

    <KSADllRepoDir Condition="'$(KSADllRepoDir)' == '' and '$(KSA_DLL_REPO_DIR)' != ''">$(KSA_DLL_REPO_DIR)</KSADllRepoDir>
    <KSADllRepoDir Condition="'$(KSADllRepoDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\KSADLLs\')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\KSADLLs\'))</KSADllRepoDir>
    <KSADllRepoDir Condition="'$(KSADllRepoDir)' != '' and !HasTrailingSlash('$(KSADllRepoDir)')">$(KSADllRepoDir)/</KSADllRepoDir>

    <UseKsaNuGetPackages Condition="'$(UseKsaNuGetPackages)' == '' and '$(CI)' == 'true'">true</UseKsaNuGetPackages>
    <UseKsaNuGetPackages Condition="'$(UseKsaNuGetPackages)' == ''">false</UseKsaNuGetPackages>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <GitShortHash>nogit</GitShortHash>
    <InformationalVersionPostfix></InformationalVersionPostfix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <InformationalVersionPostfix>-debug</InformationalVersionPostfix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Import Project="$(KSADir)KsaNuGet.props" Condition="Exists('$(KSADir)KsaNuGet.props')" />
  <Import Project="$(KSADllRepoDir)KsaNuGet.props" Condition="!Exists('$(KSADir)KsaNuGet.props') and '$(KSADllRepoDir)' != '' and Exists('$(KSADllRepoDir)KsaNuGet.props')" />

  <PropertyGroup>
    <HarmonyVersion Condition="'$(HarmonyVersion)' == ''">2.4.3</HarmonyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" Condition="'$(IncludeHarmony)' != 'false'" />
  </ItemGroup>
</Project>
