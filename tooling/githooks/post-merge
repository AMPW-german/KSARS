#!/usr/bin/env sh
# Syncs the tooling submodule on git pull/merge or checkout unless dirty or overridden.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

if [ ! -e "tooling/.git" ]; then
  git submodule update --init --recursive -- tooling || true
  exit 0
fi

if [ -n "$(git -C tooling status --porcelain 2>/dev/null)" ]; then
  echo "[KSAModTools] Warning: 'tooling/' has uncommitted changes; skipping submodule sync." >&2
  exit 0
fi

OVERRIDE="$(git config --local --get submodule.tooling.override 2>/dev/null || true)"

if [ -z "$OVERRIDE" ]; then
  for f in */*.csproj.user *.csproj.user */*.csproj *.csproj; do
    if [ -f "$f" ]; then
      MATCH="$(sed -n 's/.*<ToolingRef>\([^<]*\)<\/ToolingRef>.*/\1/p' "$f" | head -n 1)"
      if [ -n "$MATCH" ]; then
        OVERRIDE="$MATCH"
        break
      fi
    fi
  done
fi

case "$OVERRIDE" in
  off|none|false)
    echo "[KSAModTools] Submodule sync disabled via override ('$OVERRIDE')."
    exit 0
    ;;
  "")
    git submodule update --init --recursive -- tooling
    ;;
  *)
    echo "[KSAModTools] Applying tooling override: $OVERRIDE"
    git -C tooling fetch origin --quiet
    if git -C tooling show-ref --verify --quiet "refs/remotes/origin/$OVERRIDE"; then
      git -C tooling checkout -B "$OVERRIDE" "origin/$OVERRIDE" --quiet
    else
      git -C tooling checkout "$OVERRIDE" --quiet
    fi
    ;;
esac
